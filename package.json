{
  "name": "libreri",
  "private": true,
  "description": "Libreri — a local-first library for books, papers, comics and audiobooks.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @libreri/desktop tauri dev",
    "build": "pnpm --filter @libreri/desktop tauri build",
    "lint": "pnpm -r lint && cargo clippy --workspace --all-targets -- -D warnings",
    "format": "pnpm -r format && cargo fmt --all",
    "test": "pnpm -r test && cargo test --workspace",
    "gen:ipc": "cargo test -p libreri-desktop export_typescript_bindings",
    "icons": "pnpm --filter @libreri/desktop tauri icon ../../assets/app-icon.png"
  }
}
